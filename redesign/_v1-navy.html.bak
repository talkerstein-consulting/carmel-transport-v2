<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Home | Carmel</title>
<meta name="description" content="Carmel USA brings 50 years of experience in Drayage trucking. Drayage, refrigerated containers, intermodal trucking and storage facility services. Open 24 / 7 / 365.">
<link rel="icon" href="assets/logo/carmel-logo-transparent.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;600;700;800&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="shell">
    <ul class="topbar-list">
      <li>78 John Miller Way, Kearny, NJ 07032</li>
      <li><a href="mailto:quotes@carmel-usa.com">quotes@carmel-usa.com</a></li>
    </ul>
    <ul class="topbar-list">
      <li>Emergency: <b><a href="tel:+16468087266">(646) 808-7266</a></b> (24/7)</li>
      <li>Sales: <b><a href="tel:+12012995416">(201) 299-5416</a></b></li>
    </ul>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="site-header" id="header">
  <div class="shell">
    <nav class="nav" aria-label="Main">
      <a class="brand" href="/">
        <img src="assets/logo/carmel-logo-transparent.png" alt="Carmel Transport">
        <span>
          <span class="brand-name">Carmel Transport</span>
          <span class="brand-sub">Drayage &amp; Intermodal</span>
        </span>
      </a>

      <button class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>

      <ul class="nav-links" id="navLinks">
        <li><a href="/" aria-current="page">Home</a></li>
        <li class="has-sub">
          <a href="#services">Services</a>
          <ul class="sub">
            <li><a href="#drayage">Drayage</a></li>
            <li><a href="#refrigerated">Refridgerated Containers</a></li>
            <li><a href="#intermodal">Intermodal Trucking</a></li>
            <li><a href="#storage">Storage Facility</a></li>
          </ul>
        </li>
        <li><a href="#company">Company</a></li>
        <li><a href="#careers">Careers</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <a class="btn btn--primary" href="#contact">Request a Quote</a>
    </nav>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero">
  <div class="hero-media">
    <img src="assets/img/slider.jpg" alt="" aria-hidden="true">
  </div>
  <div class="shell">
    <div class="hero-copy">
      <p class="eyebrow eyebrow--on-dark">Leading Provider of Drayage Services</p>
      <h1>We Don&rsquo;t Just Deliver,<br><span class="accent">We Excel</span></h1>
      <div class="hero-actions">
        <a class="btn btn--primary" href="#contact">Request a Quote</a>
        <a class="btn btn--ghost" href="#services">Our Services</a>
      </div>
      <p class="route">
        <span><a href="#drayage">Drayage</a></span>
        <span><a href="#refrigerated">Refrigerated Containers</a></span>
        <span><a href="#intermodal">Intermodal Trucking</a></span>
        <span><a href="#storage">Storage Facility</a></span>
      </p>
    </div>
  </div>
</section>

<!-- ============ SIGNATURE: THE YARD STACK ============ -->
<section class="yard" aria-label="Fleet and capacity">
  <div class="stack">
    <div class="can reveal">
      <p class="can-num">50</p>
      <p class="can-label">Years of experience</p>
      <p class="can-note">In Drayage trucking, from our owners</p>
    </div>
    <div class="can reveal">
      <p class="can-num">300</p>
      <p class="can-label">Power units</p>
      <p class="can-note">Across North America</p>
    </div>
    <div class="can reveal">
      <p class="can-num">800<span class="can-unit">+</span></p>
      <p class="can-label">Chassis</p>
      <p class="can-note">20&rsquo;, 40&rsquo;, 45&rsquo; and Genset</p>
    </div>
    <div class="can reveal">
      <p class="can-num">24<span class="can-unit">/7</span></p>
      <p class="can-label">365 days</p>
      <p class="can-note">We are open 24 / 7 / 365</p>
    </div>
  </div>
</section>

<!-- ============ WELCOME / COMPANY ============ -->
<section class="section" id="company">
  <div class="shell">
    <div class="split">
      <div class="reveal">
        <p class="eyebrow">Welcome to Carmel USA!</p>
        <h2>A Transportation Partner You Can Count On</h2>
        <p class="lede">Carmel USA brings 50 years of experience in Drayage trucking from it&rsquo;s owners. We always prioritized punctuality and tailored customer service. Those principles shape our work in the Drayage industry.</p>
        <p>We aim to give precise quotes that will end up on the invoice without any &lsquo;surprises&rsquo; nor any extra charges.</p>
        <p>Carmel Transport manages a robust fleet of 300 power units across North America and over 800 chassis. This diversity means we can cater to various container types and sizes, from 20&rsquo;, 40&rsquo;, 45&rsquo;, and including any kind of container delivery: dry, overweight, refrigerated, open top, flat rack.</p>
        <p>Our yards are close to major seaports and rail terminals which lets us offer Secured yard storage, perfect for both short-term and long-term needs.</p>
        <div class="hero-actions">
          <a class="btn btn--outline" href="#">More About Us</a>
        </div>
      </div>
      <div class="split-media reveal">
        <img src="assets/img/carmel-team.jpg" alt="The Carmel Transport team">
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="section section--fog" id="services">
  <div class="shell">
    <div class="section-head section-head--split reveal">
      <div>
        <p class="eyebrow">What we do</p>
        <h2>Services</h2>
      </div>
      <a class="btn btn--outline" href="#contact">Request a Quote</a>
    </div>

    <div class="svc-grid">
      <article class="svc reveal" id="drayage">
        <div class="svc-img">
          <img src="assets/img/drayage.jpg" alt="Drayage">
          <span class="svc-tag">Drayage</span>
        </div>
        <div class="svc-body">
          <h3>Drayage</h3>
          <p>We provide a full range asset-based drayage and full transload services</p>
          <a class="svc-more" href="#">Read More</a>
        </div>
      </article>

      <article class="svc reveal" id="refrigerated">
        <div class="svc-img">
          <img src="assets/img/refrigerated.jpg" alt="Refrigerated Containers">
          <span class="svc-tag">Refrigerated</span>
        </div>
        <div class="svc-body">
          <h3>Refrigerated Containers</h3>
          <p>We offer all-encompassing storage and transit of refrigerated containers</p>
          <a class="svc-more" href="#">Read More</a>
        </div>
      </article>

      <article class="svc reveal" id="intermodal">
        <div class="svc-img">
          <img src="assets/img/intermodal-trucking.jpg" alt="Intermodal Trucking">
          <span class="svc-tag">Intermodal</span>
        </div>
        <div class="svc-body">
          <h3>Intermodal Trucking</h3>
          <p>We operate to ocean and rail container terminals, ensuring your goods reach their destination</p>
          <a class="svc-more" href="#">Read More</a>
        </div>
      </article>

      <article class="svc reveal" id="storage">
        <div class="svc-img">
          <img src="assets/img/storage-facility.jpg" alt="Storage Facility">
          <span class="svc-tag">Storage</span>
        </div>
        <div class="svc-body">
          <h3>Storage Facility</h3>
          <p>We provide an all-inclusive storage solution for all sizes of dry-box and refrigerated containers</p>
          <a class="svc-more" href="#">Read More</a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- ============ CAPABILITY PAIR ============ -->
<section class="section section--navy">
  <div class="shell">
    <div class="split split--flip">
      <div class="split-media reveal">
        <img src="assets/img/containers-3.jpg" alt="Containers">
      </div>
      <div class="reveal">
        <p class="eyebrow eyebrow--on-dark">Why Carmel</p>
        <div class="pair pair--stacked">
          <article>
            <h3>A Transportation Partner You Can Count On</h3>
            <p>As a trusted leader in logistics, we offer flexible and affordable solutions for large volumes of import and export containers. Our dedicated team diligently monitors every shipment round-the-clock, ensuring a seamless transition with services including transportation from regional terminals, pre-arranged rail reservations, and high-security bolt seals.</p>
          </article>
          <article>
            <h3>Leading the Way in Specialized Transportation Services</h3>
            <p>We&rsquo;re experts in handling refrigerated and intermodal trucking, offering more than just transport. Our skilled drivers and plentiful Genset chassis manage temperature-sensitive freight, while our logistics branch offers optimized storage facilities. We handle all documentation and border clearances for US shipments. Our goal is to instill confidence and reassure you in our reliable transportation process.</p>
          </article>
        </div>
        <ul class="equip">
          <li class="chip chip--key">20&rsquo;</li>
          <li class="chip chip--key">40&rsquo;</li>
          <li class="chip chip--key">45&rsquo;</li>
          <li class="chip">Dry</li>
          <li class="chip">Overweight</li>
          <li class="chip">Refrigerated</li>
          <li class="chip">Open top</li>
          <li class="chip">Flat rack</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- ============ TRIO ============ -->
<section class="section section--fog">
  <div class="shell">
    <div class="section-head reveal">
      <p class="eyebrow">What we bring</p>
      <h2>Your Partner in Efficient, Secure Logistics</h2>
      <p class="lede">At Carmel USA, we offer efficient, cost-effective solutions for your import and export needs, handling large volumes of cargo with ease. Our 24/7 customer service vigilantly tracks your containers, managing everything from transportation, rail reservations, to cross-border freight. We also ensure safety with our high-security bolt seals for export shipments. With us, experience transparent and efficient logistics solutions.</p>
    </div>

    <div class="trio">
      <article class="reveal">
        <h3>Temperature-Controlled Solutions</h3>
        <p>Carmel USA expertly manages refrigerated container transport and storage with our skilled drivers and robust Genset chassis. We can accommodate 30 units concurrently, fulfilling your temperature-sensitive cargo needs.</p>
      </article>
      <article class="reveal">
        <h3>Shipment Services</h3>
        <p>As a nationally recognized Carrier, we offer comprehensive shipment services. Our team expertly handles essential documentation and expedites border clearances, extending our expertise to key states like New York, Michigan, Ohio, and Pennsylvania. Trust Carmel USA for efficient transport solutions.</p>
      </article>
      <article class="reveal">
        <h3>Join the Carmel Team</h3>
        <p>Carmel USA aims to exceed industry standards with exceptional service and operational excellence. Interested in joining our dedicated team? Visit our career page for more.</p>
      </article>
    </div>
  </div>
</section>

<!-- ============ CONTACT / QUOTE ============ -->
<section class="section section--navy" id="contact">
  <div class="shell">
    <div class="quote-grid">
      <div class="reveal">
        <p class="eyebrow eyebrow--on-dark">We Are Here To Help</p>
        <h2>Request a Quote</h2>
        <p class="lede">Reach out to one of our knowledgeable team members. If you have any queries or need assistance with directions, sales, or have questions regarding billing, don&rsquo;t hesitate to contact us right away!</p>
        <p class="lede">Contact us today to request a quote or click the link a custom freight quote online. We look forward to being the full-service company you trust for all of your transport needs.</p>
        <dl class="contact-list">
          <div>
            <dt>Address</dt>
            <dd>78 John Miller Way, Kearny, NJ 07032 unit #408</dd>
          </div>
          <div>
            <dt>Phones</dt>
            <dd>
              <a href="tel:+16468087266">Emergency: (646) 808-7266</a> (24/7)
              <small>Sales: <a href="tel:+12012995416">(201) 299-5416</a></small>
              <small>Other inquiries: <a href="tel:+12012995417">(201) 299-5417</a></small>
            </dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:quotes@carmel-usa.com">quotes@carmel-usa.com</a></dd>
          </div>
          <div>
            <dt>Opening Hours</dt>
            <dd>We are open 24 / 7 / 365</dd>
          </div>
        </dl>
      </div>

      <form class="form reveal" action="#" method="post">
        <div class="form-row">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" type="text" autocomplete="name" required>
          </div>
          <div class="field">
            <label for="company">Company</label>
            <input id="company" name="company" type="text" autocomplete="organization">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel">
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="service">Service</label>
            <select id="service" name="service">
              <option>Drayage</option>
              <option>Refrigerated Containers</option>
              <option>Intermodal Trucking</option>
              <option>Storage Facility</option>
            </select>
          </div>
          <div class="field">
            <label for="size">Container</label>
            <select id="size" name="size">
              <option>20&rsquo;</option>
              <option>40&rsquo;</option>
              <option>45&rsquo;</option>
              <option>Dry</option>
              <option>Overweight</option>
              <option>Refrigerated</option>
              <option>Open top</option>
              <option>Flat rack</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="details">Message</label>
          <textarea id="details" name="details"></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Request a Quote</button>
        <p class="form-note form-note--ok" role="status" hidden>Success! Your message has been sent to us.</p>
        <p class="form-note form-note--err" role="alert" hidden>Error! There was an error sending your message.</p>
      </form>
    </div>
  </div>
</section>

<!-- ============ CAREERS BAND ============ -->
<section class="band" id="careers">
  <div class="shell">
    <div>
      <h2>Join the Carmel Team</h2>
      <p>Carmel USA aims to exceed industry standards with exceptional service and operational excellence. Interested in joining our dedicated team? Visit our career page for more.</p>
    </div>
    <a class="btn btn--onyellow" href="#">Careers</a>
  </div>
</section>

